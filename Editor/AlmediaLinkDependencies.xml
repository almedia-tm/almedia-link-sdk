<?xml version="1.0" encoding="UTF-8"?>
<!--
    Almedia Link SDK - Android dependencies (EDM4U manifest)

    This file is for hosts that have EDM4U (External Dependency Manager for
    Unity) installed: EDM4U auto-resolves it on save / before Android build,
    no manual action needed.

    Hosts WITHOUT EDM4U get the exact same dependencies automatically via the
    Unity .androidlib subproject at:
        Packages/com.almedia.link/Plugins/Android/AlmediaLink.androidlib/

    Keep this file and AlmediaLink.androidlib/build.gradle in lockstep when
    bumping versions. Pinned for Unity 2022.3 / AGP 7.x / D8 compatibility.
-->
<dependencies>
    <androidPackages>
        <!-- Kotlin coroutines. 1.7.3 is the last release built with Kotlin 1.8 -
             newer ones carry Kotlin >= 1.9 metadata that crashes D8 on AGP 7.x
             (Unity 2022.3) when desugaring for minSdk < 24. -->
        <androidPackage spec="org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.3"/>
        <androidPackage spec="org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3"/>

        <!-- Kotlin serialization. 1.5.1 for the same reason: last Kotlin 1.8 build. -->
        <androidPackage spec="org.jetbrains.kotlinx:kotlinx-serialization-json:1.5.1"/>
    </androidPackages>
</dependencies>
